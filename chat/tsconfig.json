{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "include": [
    "*.ts",
    "*.tsx",
    "screens/**/*.tsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "types/**/*.d.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ],
  "compilerOptions": {
    "types": [
      "react-native",
      "jest",
      "node"
    ],
    "esModuleInterop": true,
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ]
  }
}
